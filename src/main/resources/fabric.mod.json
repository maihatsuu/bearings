		"main": [
			"maihatsuu.bearings.Bearings"
		],
		"client": [
			"maihatsuu.bearings.client.BearingsClient"
		],
		"modmenu": [
			"maihatsuu.bearings.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "bearings.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"trinkets": "*",
		"betterf3": "*",
		"modmenu": "*",
		"cloth-config": "*"
	}
}
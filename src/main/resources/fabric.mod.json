{
	"schemaVersion": 1,
	"id": "bearings",
	"version": "${version}",
	"name": "Bearings",
	"description": "F3 only shows coordinates while you carry a compass, and the time while you carry a clock. Both can be worn on your belt.",
	"authors": [
		"maihatsuu"
	],
	"contact": {
		"homepage": "https://github.com/maihatsuu/bearings",
		"sources": "https://github.com/maihatsuu/bearings"
	},
	"license": "CC0-1.0",
	"icon": "assets/bearings/icon.png",
	"environment": "*",
